[Desktop Entry]
Name=Black Box Next
Exec=blackbox-next
Actions=new-tab;
Terminal=false
Type=Application
Categories=GNOME;GTK;System;TerminalEmulator;
StartupNotify=false
Keywords=Terminal;terminal;shell;prompt;command;commandline;cmd;box;run;
Icon=com.neg-zero.BlackBoxNext
X-GNOME-UsesNotifications=true
X-ExecArg=--
X-TerminalArgExec=--
X-TerminalArgDir=--working-directory

[Desktop Action new-tab]
Name=New Tab
Exec=blackbox-next --tab
